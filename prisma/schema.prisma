generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id               String         @id @default(cuid())
  email            String         @unique
  name             String?
  passwordHash     String
  plan             String         @default("free")
  planExpiresAt    DateTime?
  usageThisMonth   Int            @default(0)
  usageResetAt     DateTime       @default(now())
  digestOptOut     Boolean        @default(false)
  digestFrequency  String         @default("weekly")
  lsCustomerId     String?
  lsSubscriptionId String?
  createdAt        DateTime       @default(now())
  sessions         Session[]
  meetingNotes     MeetingNote[]
  actionItems      ActionItem[]
  decisions        Decision[]
  memberships      Membership[]
  notifications    Notification[]
}

model Organization {
  id               String               @id @default(cuid())
  name             String
  slug             String               @unique
  plan             String               @default("free")
  planExpiresAt    DateTime?
  lsCustomerId     String?
  lsSubscriptionId String?
  createdAt        DateTime             @default(now())
  memberships      Membership[]
  invites          OrganizationInvite[]
  meetingNotes     MeetingNote[]
  actionItems      ActionItem[]
  decisions        Decision[]
}

model Membership {
  userId         String
  organizationId String
  role           String       @default("member")
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([userId, organizationId])
  @@index([organizationId])
}

model OrganizationInvite {
  id             String       @id @default(cuid())
  organizationId String
  email          String
  role           String       @default("member")
  createdAt      DateTime     @default(now())
  acceptedAt     DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([email])
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MeetingNote {
  id             String        @id @default(cuid())
  userId         String
  organizationId String?
  title          String
  audioName      String
  notesJson      String
  markdown       String
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actionItems    ActionItem[]
  decisions      Decision[]

  @@index([organizationId])
}

model ActionItem {
  id               String        @id @default(cuid())
  meetingNoteId    String
  userId           String
  organizationId   String?
  task             String
  owner            String
  deadline         String
  priority         String
  status           String        @default("todo")
  notes            String
  lastReminderSent DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  meetingNote      MeetingNote   @relation(fields: [meetingNoteId], references: [id], onDelete: Cascade)
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([lastReminderSent])
}

model Decision {
  id             String        @id @default(cuid())
  meetingNoteId  String
  userId         String
  organizationId String?
  content        String
  createdAt      DateTime      @default(now())
  meetingNote    MeetingNote   @relation(fields: [meetingNoteId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  read      Boolean  @default(false)
  actionUrl String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}
